{
    "name": "@chronos-samples/three-ts-types",
    "version": "1.0.0",
    "description": "TypeScript type definitions for Three.js (Chronos-Samples fork)",
    "license": "MIT",

    "types": "./index.d.ts",

    "exports": {
        ".": {
            "types": "./index.d.ts"
        },
        "./three": {
            "types": "./types/three/index.d.ts"
        }
    },

    "files": [
        "index.d.ts",
        "types/three"
    ],

    "scripts": {
        "test": "node --require source-map-support/register node_modules/@definitelytyped/dtslint/ types/three",
        "lint": "node --require source-map-support/register node_modules/@definitelytyped/dtslint/ types/three",
        "test-all": "node --require source-map-support/register node_modules/@definitelytyped/dtslint-runner/ --path .",
        "format": "dprint fmt",
        "format-check": "dprint check"
    },

    "devDependencies": {
        "@definitelytyped/definitions-parser": "latest",
        "@definitelytyped/dts-critic": "latest",
        "@definitelytyped/dtslint": "latest",
        "@definitelytyped/dtslint-runner": "latest",
        "@definitelytyped/eslint-plugin": "latest",
        "@definitelytyped/header-parser": "latest",
        "@definitelytyped/typescript-versions": "latest",
        "@definitelytyped/utils": "latest",
        "@types/stats.js": "*",
        "@types/webxr": "*",
        "dprint": "^0.45.0",
        "source-map-support": "^0.5.21",
        "typescript": "latest"
    },

    "repository": {
        "type": "git",
        "url": "https://github.com/Chronos-Samples/three-ts-types.git"
    }
}